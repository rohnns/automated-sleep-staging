# Bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local data (Sleep-EDF files are large — keep out of VCS)
data/

# Encoding cache — multi-GB. Lives outside the repo by default
# (SLEEP_CACHE_ROOT); this guards against a stray in-repo cache tree.
artifacts/cache/

# Offline analysis artifacts (legacy location)
analysis/outputs/

# Generated outputs
outputs/checkpoints/
outputs/predictions/
outputs/reports/
outputs/figures/
outputs/classical_baseline/

# Run artifacts regenerated by `python main.py` (checkpoints are large binaries)
models/
artifacts/predictions/
artifacts/figures/
artifacts/reports

# Keep the legacy whole-night exports tracked (committed artifacts) even
# though they live under outputs/ -- no blanket outputs/ rule above touches
# outputs/model_outputs/ or root-level outputs/*.md, so no exception is
# actually needed here; this comment exists so a future blanket rule doesn't
# accidentally re-exclude them without a maintainer noticing.

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Environment secrets
.env
.env.*
